import React from 'react';
import { useLocation } from '@docusaurus/router';

const LOCALES: string[] = [
  {% for loc in site.locales %}
  '{{ loc }}',
  {% endfor %}
];

const DEFAULT_LOCALE = '{{ site.locale }}';

const NATIVE_LANGUAGE_NAMES: Record<string, string> = {
  en: 'English',
  ru: 'Русский',
  de: 'Deutsch',
  fr: 'Français',
  es: 'Español',
  pt: 'Português',
  'pt-br': 'Português (Brasil)',
  zh: '中文',
  'zh-cn': '简体中文',
  'zh-tw': '繁體中文',
  ja: '日本語',
  ko: '한국어',
  ar: 'العربية',
  it: 'Italiano',
  nl: 'Nederlands',
  pl: 'Polski',
  tr: 'Türkçe',
  hi: 'हिन्दी',
  uk: 'Українська',
  cs: 'Čeština',
  sv: 'Svenska',
};

function getLocaleLabel(locale: string): string {
  const normalized = locale.toLowerCase();
  if (NATIVE_LANGUAGE_NAMES[normalized]) {
    return NATIVE_LANGUAGE_NAMES[normalized];
  }

  const base = normalized.split('-')[0];
  if (NATIVE_LANGUAGE_NAMES[base]) {
    return NATIVE_LANGUAGE_NAMES[base];
  }

  return locale;
}

function getLocalePath(targetLocale: string, currentLocale: string, pathname: string): string {
  let base = pathname;

  if (currentLocale !== DEFAULT_LOCALE) {
    const prefix = '/' + currentLocale;
    if (base.startsWith(prefix + '/')) {
      base = base.slice(prefix.length);
    } else if (base === prefix) {
      base = '/';
    }
  }

  if (targetLocale === DEFAULT_LOCALE) {
    return base || '/';
  }

  return '/' + targetLocale + (base.startsWith('/') ? base : '/' + base);
}

function detectCurrentLocale(pathname: string): string {
  for (const loc of LOCALES) {
    if (loc !== DEFAULT_LOCALE) {
      if (pathname.startsWith('/' + loc + '/') || pathname === '/' + loc) {
        return loc;
      }
    }
  }
  return DEFAULT_LOCALE;
}

export default function LocaleDropdown(): JSX.Element | null {
  const location = useLocation();
  const currentLocale = detectCurrentLocale(location.pathname);

  if (LOCALES.length <= 1) return null;

  return (
    <div className="df-locale">
      <button
        type="button"
        className="clean-btn df-locale__btn"
        aria-label="Change language"
        title="Change language"
      >
        <svg
          viewBox="0 0 24 24"
          fill="currentColor"
          width="20"
          height="20"
          aria-hidden="true"
          className="df-locale__icon"
        >
          <path d="M12.87 15.07 10.33 12.53l.03-.03c1.74-1.94 2.98-4.17 3.71-6.5H17v-2h-7V2H8v2H3v2h9.17a13.4 13.4 0 0 1-3.39 5.35 12.3 12.3 0 0 1-2.47-3.35H4.31a16.3 16.3 0 0 0 3.34 4.93l-5.09 5.08L3.98 19.78l5.09-5.09 3.17 3.17.63-2.79ZM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12ZM16 17l1.62-4.33L19.25 17H16Z" />
        </svg>

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          strokeWidth="2.5"
          strokeLinecap="round"
          strokeLinejoin="round"
          width="12"
          height="12"
          aria-hidden="true"
          className="df-locale__chevron"
        >
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </button>

      <ul className="df-locale__menu" role="listbox" aria-label="Languages">
        {LOCALES.map((locale) => (
          <li key={locale} role="option">
            <a
              href={getLocalePath(locale, currentLocale, location.pathname)}
              className={`df-locale__item${locale === currentLocale ? ' df-locale__item--active' : ''}`}
            >
              {getLocaleLabel(locale)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  );
}
