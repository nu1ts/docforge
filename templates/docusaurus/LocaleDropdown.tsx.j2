import React, { useState, useRef, useEffect } from 'react';
import { useLocation } from '@docusaurus/router';

const LOCALES: { code: string; label: string }[] = [
  {% for loc in site.locales %}
  { code: '{{ loc }}', label: '{{ loc | upper }}' },
  {% endfor %}
];

const DEFAULT_LOCALE = '{{ site.locale }}';

function getLocalePath(targetLocale: string, currentLocale: string, pathname: string): string {
  let base = pathname;

  if (currentLocale !== DEFAULT_LOCALE) {
    const prefix = '/' + currentLocale;
    if (base.startsWith(prefix + '/')) {
      base = base.slice(prefix.length);
    } else if (base === prefix) {
      base = '/';
    }
  }

  if (targetLocale === DEFAULT_LOCALE) {
    return base || '/';
  }
  return '/' + targetLocale + (base.startsWith('/') ? base : '/' + base);
}

function detectCurrentLocale(pathname: string): string {
  for (const loc of LOCALES) {
    if (loc.code !== DEFAULT_LOCALE) {
      if (pathname.startsWith('/' + loc.code + '/') || pathname === '/' + loc.code) {
        return loc.code;
      }
    }
  }
  return DEFAULT_LOCALE;
}

export default function LocaleDropdown(): JSX.Element | null {
  const [open, setOpen] = useState(false);
  const ref = useRef<HTMLDivElement>(null);
  const location = useLocation();
  const currentLocale = detectCurrentLocale(location.pathname);

  useEffect(() => {
    function handleClick(e: MouseEvent) {
      if (ref.current && !ref.current.contains(e.target as Node)) {
        setOpen(false);
      }
    }
    document.addEventListener('mousedown', handleClick);
    return () => document.removeEventListener('mousedown', handleClick);
  }, []);

  useEffect(() => {
    setOpen(false);
  }, [location.pathname]);

  if (LOCALES.length <= 1) return null;

  return (
    <div
      ref={ref}
      className={`df-locale${open ? ' df-locale--open' : ''}`}
    >
      <button
        type="button"
        className="clean-btn df-locale__btn"
        onClick={() => setOpen((v) => !v)}
        aria-label="Change language"
        title="Change language"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
        </svg>
      </button>

      {open && (
        <ul className="df-locale__menu" role="listbox">
          {LOCALES.map((loc) => (
            <li key={loc.code} role="option">
              <a
                href={getLocalePath(loc.code, currentLocale, location.pathname)}
                className={`df-locale__item${loc.code === currentLocale ? ' df-locale__item--active' : ''}`}
                onClick={() => setOpen(false)}
              >
                {loc.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  );
}
