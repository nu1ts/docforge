/* ─── Keyframes injected once ───────────────────────────── */

const CSS_KEYFRAMES = `
@keyframes df-spin  { to { transform: rotate(360deg); } }
@keyframes df-shake {
    0%,100% { transform: translateX(0); }
    20%     { transform: translateX(-7px); }
    40%     { transform: translateX(7px); }
    60%     { transform: translateX(-4px); }
    80%     { transform: translateX(4px); }
}
@keyframes df-fade-in {
    from { opacity: 0; transform: translateY(10px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
}
.df-auth-card { animation: df-fade-in 0.35s cubic-bezier(0.4,0,0.2,1) both; }
.df-shake     { animation: df-shake  0.35s ease; }
.df-spinner   {
    display: inline-block;
    width: 14px; height: 14px;
    border: 2px solid rgba(255,255,255,0.25);
    border-top-color: white;
    border-radius: 50%;
    animation: df-spin 0.65s linear infinite;
    vertical-align: middle;
}
`;

/* ─── Component ─────────────────────────────────────────── */

export default function Root({children}: {children: React.ReactNode}) {
    const [authorized,  setAuthorized]  = useState(false);
    const [checking,    setChecking]    = useState(true);
    const [input,       setInput]       = useState('');
    const [showPass,    setShowPass]    = useState(false);
    const [error,       setError]       = useState('');
    const [loading,     setLoading]     = useState(false);
    const [focused,     setFocused]     = useState(false);
    const [attempts,    setAttempts]    = useState(0);
    const [lockedUntil, setLockedUntil] = useState<number | null>(null);
    const [timeLeft,    setTimeLeft]    = useState(0);
    const [btnHover,    setBtnHover]    = useState(false);
    const cardRef = useRef<HTMLDivElement>(null);

    /* Inject keyframes once */
    useEffect(() => {
        const el = document.createElement('style');
        el.textContent = CSS_KEYFRAMES;
        document.head.appendChild(el);
        return () => {
            el.remove();
        };
    }, []);

    /* Check stored token */
    useEffect(() => {
        const saved = localStorage.getItem(TOKEN_KEY);
        if (saved) {
            sha256(saved).then(h => {
                if (VALID_HASHES.includes(h)) setAuthorized(true);
                setChecking(false);
            });
        } else {
            setChecking(false);
        }
    }, []);

    /* Lockout countdown */
    useEffect(() => {
        if (!lockedUntil) return;
        const id = setInterval(() => {
            const left = Math.ceil((lockedUntil - Date.now()) / 1000);
            if (left <= 0) {
                setLockedUntil(null);
                setAttempts(0);
                setTimeLeft(0);
            } else {
                setTimeLeft(left);
            }
        }, 500);
        return () => clearInterval(id);
    }, [lockedUntil]);

    const shake = useCallback(() => {
        const el = cardRef.current;
        if (!el) return;
        el.classList.add('df-shake');
        setTimeout(() => el.classList.remove('df-shake'), 400);
    }, []);

    const handleSubmit = useCallback(async () => {
        if (!input.trim() || loading || !!lockedUntil) return;
        setLoading(true);
        setError('');

        const hash = await sha256(input.trim());

        if (VALID_HASHES.includes(hash)) {
            localStorage.setItem(TOKEN_KEY, input.trim());
            setAuthorized(true);
        } else {
            const next = attempts + 1;
            setAttempts(next);
            if (next >= MAX_ATTEMPTS) {
                setLockedUntil(Date.now() + LOCKOUT_MS);
            } else {
                const left = MAX_ATTEMPTS - next;
                setError(
                    next >= 3
                        ? `// invalid_token — ${left} attempt${left === 1 ? '' : 's'} remaining`
                        : '// invalid_token — please try again',
                );
                shake();
            }
            setInput('');
        }
        setLoading(false);
    }, [input, loading, lockedUntil, attempts, shake]);

    /* ── Loading splash ── */
    if (checking) {
        return (
            <div style={S.overlay}>
                <div style={% raw %}{{...S.card, padding: '32px', maxWidth: '200px', alignItems: 'center'}}{% endraw %}>
                    <span className="df-spinner" style={% raw %}{{width: '24px', height: '24px'}}{% endraw %} />
                </div>
            </div>
        );
    }

    if (authorized) return <>{children}</>;

    /* ── Derived ── */
    const isLocked  = !!lockedUntil;
    const isDisabled = !input.trim() || loading || isLocked;

    const inputStyle = {
        ...S.input,
        ...(focused && !error && !isLocked ? S.inputFocus : {}),
        ...(error                          ? S.inputError : {}),
        ...(isLocked                       ? S.inputDisabled : {}),
    };

    const btnStyle = {
        ...S.btn,
        ...(isDisabled  ? S.btnDisabled : {}),
        ...(!isDisabled && btnHover
            ? {opacity: 0.92, transform: 'translateY(-1px)', boxShadow: '0 8px 28px rgba(79,70,229,0.55)'}
            : {}),
    };

    /* ── Auth screen ── */
    return (
        <div style={S.overlay}>
            {/* Grid background */}
            <div style={S.grid} aria-hidden />

            <div ref={cardRef} id="df-auth-card" className="df-auth-card" style={S.card}>
                {/* Top glow line */}
                <div style={S.topGlow} aria-hidden />

                {/* Logo */}
                <div style={S.logoWrap} aria-hidden>
                    <svg width="30" height="30" viewBox="0 0 32 32" fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <path
                            d="M16 2L4 7v9c0 7 5.4 12.4 12 14 6.6-1.6 12-7 12-14V7L16 2z"
                            fill="rgba(255,255,255,0.20)"
                        />
                        <path
                            d="M11 16h10M11 12h6M11 20h8"
                            stroke="white" strokeWidth="1.75" strokeLinecap="round"
                        />
                    </svg>
                </div>

                <h1 style={S.title}>Access Required</h1>
                <p style={S.subtitle}>
                    This documentation is protected.<br />
                    Enter your developer token to continue.
                </p>

                {/* Input label */}
                <span style={S.label}>_ access_token</span>

                <div style={S.inputWrap}>
                    <input
                        id="df-token-input"
                        type={showPass ? 'text' : 'password'}
                        placeholder="docforge-••••••••••••"
                        value={input}
                        disabled={isLocked || loading}
                        onChange={e => {
                            setInput(e.target.value);
                            if (error) setError('');
                        }}
                        onFocus={() => setFocused(true)}
                        onBlur={() => setFocused(false)}
                        onKeyDown={e => e.key === 'Enter' && handleSubmit()}
                        autoComplete="off"
                        autoFocus
                        style={inputStyle}
                        aria-label="Developer access token"
                        aria-describedby={error ? 'df-error' : undefined}
                    />
                    <button
                        type="button"
                        onClick={() => setShowPass(v => !v)}
                        style={S.eyeBtn}
                        tabIndex={-1}
                        aria-label={showPass ? 'Hide token' : 'Show token'}
                    >
                        {showPass ? '🙈' : '👁️'}
                    </button>
                </div>

                {/* Error */}
                {error && !isLocked && (
                    <div id="df-error" role="alert"
                         style={% raw %}{{...S.alertBase, ...S.alertError}}{% endraw %}>
                        <span aria-hidden>⚠</span>
                        {error}
                    </div>
                )}

                {/* Lockout */}
                {isLocked && (
                    <div role="alert"
                         style={% raw %}{{...S.alertBase, ...S.alertLock}}{% endraw %}>
                        <span aria-hidden>🔒</span>
                        // locked — retry in {timeLeft}s
                    </div>
                )}

                {/* Submit */}
                <button
                    onClick={handleSubmit}
                    disabled={isDisabled}
                    style={btnStyle}
                    onMouseEnter={() => setBtnHover(true)}
                    onMouseLeave={() => setBtnHover(false)}
                    aria-label="Verify token and access documentation"
                >
                    {loading ? (
                        <span style={S.spinnerWrap}>
                            <span className="df-spinner" />
                            Verifying…
                        </span>
                    ) : (
                        '$ access --docs →'
                    )}
                </button>

                {/* Footer */}
                <p style={S.footer}>
                    No token? Contact your team lead.<br />
                    Built with{' '}
                    <a href="https://github.com/nu1ts/docforge" style={S.footerLink}
                       target="_blank" rel="noopener noreferrer">
                        docforge
                    </a>
                    {' '}⚡
                </p>
            </div>
        </div>
    );
}
