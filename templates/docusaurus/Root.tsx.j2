export default function Root({children}: {children: React.ReactNode}) {
    const [authorized, setAuthorized]   = useState(false);
    const [checking,   setChecking]     = useState(true);
    const [input,      setInput]        = useState('');
    const [showPass,   setShowPass]     = useState(false);
    const [error,      setError]        = useState('');
    const [loading,    setLoading]      = useState(false);
    const [focused,    setFocused]      = useState(false);
    const [attempts,   setAttempts]     = useState(0);
    const [lockedUntil, setLockedUntil] = useState<number | null>(null);
    const [timeLeft,   setTimeLeft]     = useState(0);

    useEffect(() => {
        const saved = localStorage.getItem(TOKEN_KEY);
        if (saved) {
            sha256(saved).then(hash => {
                if (VALID_HASHES.includes(hash)) setAuthorized(true);
                setChecking(false);
            });
        } else {
            setChecking(false);
        }
    }, []);

    useEffect(() => {
        if (!lockedUntil) return;
        const interval = setInterval(() => {
            const left = Math.ceil((lockedUntil - Date.now()) / 1000);
            if (left <= 0) {
                setLockedUntil(null);
                setAttempts(0);
                setTimeLeft(0);
                clearInterval(interval);
            } else {
                setTimeLeft(left);
            }
        }, 500);
        return () => clearInterval(interval);
    }, [lockedUntil]);

    useEffect(() => {
        const style = document.createElement('style');
        style.textContent = `
      @keyframes spin { to { transform: rotate(360deg); } }
      @keyframes shake {
        0%,100% { transform: translateX(0); }
        25% { transform: translateX(-6px); }
        75% { transform: translateX(6px); }
      }
      .df-shake { animation: shake 0.3s ease; }
    `;
        document.head.appendChild(style);
        return () => {
            document.head.removeChild(style);
        };
    }, []);

    const handleSubmit = useCallback(async () => {
        if (!input.trim() || loading || lockedUntil) return;

        setLoading(true);
        setError('');

        const hash = await sha256(input.trim());

        if (VALID_HASHES.includes(hash)) {
            localStorage.setItem(TOKEN_KEY, input.trim());
            setAuthorized(true);
        } else {
            const newAttempts = attempts + 1;
            setAttempts(newAttempts);

            if (newAttempts >= MAX_ATTEMPTS) {
                setLockedUntil(Date.now() + LOCKOUT_MS);
                setError('');
            } else {
                setError(
                    newAttempts >= 3
                        ? `Invalid token. ${MAX_ATTEMPTS - newAttempts} attempt(s) left.`
                        : 'Invalid token. Please try again.'
                );

                const card = document.getElementById('df-auth-card');
                if (card) {
                    card.classList.add('df-shake');
                    setTimeout(() => card.classList.remove('df-shake'), 350);
                }
            }
            setInput('');
        }

        setLoading(false);
    }, [input, loading, lockedUntil, attempts]);

    if (checking) {
        return (
            <div style={styles.overlay}>
                <div style={styles.spinner} />
            </div>
        );
    }

    if (authorized) return <>{children}</>;

    const isLocked = !!lockedUntil;
    const inputStyle = {
        ...styles.input,
        ...(focused && !error && !isLocked ? styles.inputFocus : {}),
        ...(error ? styles.inputError : {}),
        ...(isLocked ? {opacity: 0.5, cursor: 'not-allowed'} : {}),
    };
    const buttonStyle = {
        ...styles.button,
        ...(!input.trim() || loading || isLocked ? styles.buttonDisabled : {}),
    };

    return (
        <div style={styles.overlay}>
            <div id="df-auth-card" style={styles.card}>
                <div style={styles.logoWrap}>
                    🔒
                </div>

                <h1 style={styles.title}>Access Required</h1>
                <p style={styles.subtitle}>
                    This documentation is protected.<br/>
                    Enter your developer token to continue.
                </p>

                <div style={styles.inputWrap}>
                    <input
                        id="df-token-input"
                        type={showPass ? 'text' : 'password'}
                        placeholder="docforge-••••••••"
                        value={input}
                        disabled={isLocked || loading}
                        onChange={e => {
                            setInput(e.target.value);
                            if (error) setError('');
                        }}
                        onFocus={() => setFocused(true)}
                        onBlur={() => setFocused(false)}
                        onKeyDown={e => e.key === 'Enter' && handleSubmit()}
                        autoComplete="off"
                        autoFocus
                        style={inputStyle}
                    />
                    <button
                        type="button"
                        onClick={() => setShowPass(v => !v)}
                        style={styles.eyeBtn}
                        tabIndex={-1}
                        aria-label={showPass ? 'Hide token' : 'Show token'}
                    >
                        {showPass ? '🙈' : '👁️'}
                    </button>
                </div>

                {error && (
                    <div style={styles.error}>
                        <span>⚠</span>
                        {error}
                    </div>
                )}

                {isLocked && (
                    <div style={styles.lockout}>
                        <span>🔒</span>
                        Too many attempts. Try again in {timeLeft}s.
                    </div>
                )}

                <button
                    onClick={handleSubmit}
                    disabled={!input.trim() || loading || isLocked}
                    style={buttonStyle}
                    onMouseEnter={e => {
                        if (!(!input.trim() || loading || isLocked)) {
                            (e.currentTarget as HTMLElement).style.opacity = '0.9';
                            (e.currentTarget as HTMLElement).style.transform = 'translateY(-1px)';
                        }
                    }}
                    onMouseLeave={e => {
                        (e.currentTarget as HTMLElement).style.opacity = '1';
                        (e.currentTarget as HTMLElement).style.transform = 'translateY(0)';
                    }}
                >
                    {loading ? (
                        <>
                            <span style={styles.spinner} />
                            Verifying…
                        </>
                    ) : (
                        'Access Documentation →'
                    )}
                </button>

                <p style={styles.footer}>
                    Don't have a token? Contact your team lead.<br/>
                    Built with{' '}
                    <a href="https://github.com/nu1ts/docforge" style={styles.footerLink}>
                        docforge
                    </a>
                </p>
            </div>
        </div>
    );
}
