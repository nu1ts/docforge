import React from 'react';

interface VersionItem {
  label: string;
  url: string;
  isCurrent: boolean;
}

const VERSIONS: VersionItem[] = [
  {% for v in site.versions %}
  { label: '{{ v.label }}', url: '{{ v.url }}', isCurrent: {{ 'true' if v.is_current else 'false' }} },
  {% endfor %}
];

export default function VersionDropdown(): JSX.Element | null {
  if (VERSIONS.length === 0) {
    return null;
  }

  const current = VERSIONS.find((v) => v.isCurrent) || VERSIONS[0];

  return (
    <div className="df-version">
      <button
        type="button"
        className="clean-btn df-version__btn"
        aria-label="Select documentation version"
        aria-haspopup="listbox"
      >
        <span className="df-version__label">{current.label}</span>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          strokeWidth="2.5"
          strokeLinecap="round"
          strokeLinejoin="round"
          width="12"
          height="12"
          aria-hidden="true"
          className="df-version__chevron"
        >
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </button>
      <ul className="df-version__menu" role="listbox">
        {VERSIONS.map((v) => (
          <li key={v.label} role="option" aria-selected={v.isCurrent}>
            <a
              href={v.url}
              className={
                'df-version__item' +
                (v.isCurrent ? ' df-version__item--active' : '')
              }
            >
              {v.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  );
}
