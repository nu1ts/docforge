const config = {
    title: '{{ site.title }}',
    tagline: '{{ config.description or "AI-powered developer documentation" }}',
    url: '{{ site.url or "https://example.github.io" }}',
    baseUrl: '{{ site.base_url or "/" }}',
    favicon: 'img/favicon.ico',

    organizationName: '{{ site.github_user }}',
    projectName: '{{ site.repo_name }}',
    trailingSlash: false,

    onBrokenLinks: 'warn',

    markdown: {
        hooks: {
            onBrokenMarkdownLinks: 'warn',
        },
    },

    {% if site.no_index %}
    noIndex: true,
    {% endif %}

    i18n: {
        defaultLocale: '{{ site.locale }}',
        locales: ['{{ site.locale }}'],
    },

    presets: [
        [
            'classic',
            {
                docs: {
                    routeBasePath: '/',
                    sidebarPath: './src/js/sidebars.js',
                    path: 'content',
                    showLastUpdateTime: true,
                },
                blog: false,
                theme: {
                    customCss: './src/css/custom.css',
                },
            },
        ],
    ],

    themeConfig: {
        colorMode: {
            defaultMode: 'dark',
            disableSwitch: false,
            respectPrefersColorScheme: true,
        },

        navbar: {
            title: '{{ site.title }}',
            hideOnScroll: false,
            style: 'dark',
            logo: {
                alt: '{{ site.title }} logo',
                src: 'img/logo.svg',
                srcDark: 'img/logo-dark.svg',
                width: 28,
                height: 28,
            },
            items: [
                {
                    type: 'doc',
                    docId: 'index',
                    position: 'left',
                    label: 'Docs',
                },
                {% if site.github_user and site.repo_name %}
                {
                    href: 'https://github.com/{{ site.github_user }}/{{ site.repo_name }}',
                    label: 'GitHub',
                    position: 'right',
                },
                {% endif %}
            ],
        },

        footer: {
            style: 'dark',
            links: [
                {% if site.github_user and site.repo_name %}
                {
                    title: 'Project',
                    items: [
                        {
                            label: 'GitHub',
                            href: 'https://github.com/{{ site.github_user }}/{{ site.repo_name }}',
                        },
                    ],
                },
                {% endif %}
                {
                    title: 'Powered by',
                    items: [
                        {
                            label: 'docforge',
                            href: 'https://github.com/nu1ts/docforge',
                        },
                        {
                            label: 'Docusaurus',
                            href: 'https://docusaurus.io',
                        },
                        {
                            label: 'Google Gemini',
                            href: 'https://aistudio.google.com',
                        },
                    ],
                },
                {
                    title: 'Search',
                    items: [
                        {
                            label: 'Set up DocSearch',
                            href: 'https://docsearch.algolia.com/apply',
                        },
                        {
                            label: 'Search docs',
                            href: 'https://docusaurus.io/docs/search',
                        },
                    ],
                },
            ],
            copyright:
                '© ' +
                new Date().getFullYear() +
                ' {{ site.title }}. Built with' +
                ' <a href="https://github.com/nu1ts/docforge">docforge</a>.',
        },

        prism: {
            theme: require('prism-react-renderer').themes.github,
            darkTheme: require('prism-react-renderer').themes.nightOwl,
            additionalLanguages: [
                'python', 'bash', 'yaml', 'toml', 'json',
                'typescript', 'go', 'rust', 'java', 'docker',
            ],
        },

        {% if config.algolia_app_id and config.algolia_api_key and config.algolia_index_name %}
        algolia: {
            appId:     '{{ config.algolia_app_id }}',
            apiKey:    '{{ config.algolia_api_key }}',
            indexName: '{{ config.algolia_index_name }}',
            contextualSearch: true,
        },
        {% endif %}

        metadata: [
            {name: 'keywords', content: 'documentation, {{ config.project_name }}, developer docs'},
            {name: 'og:type', content: 'website'},
            {name: 'og:image', content: 'img/logo.svg'},
        ],
    },
};

export default config;
